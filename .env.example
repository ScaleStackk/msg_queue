# For local access, leave this as localhost. On EC2 use the Kafka instance's
# stable private IP or private DNS name so remote workers receive a reachable
# broker address in Kafka metadata.
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PORT=9092

# Keep this stable for the lifetime of the persisted Kafka data volume.
KAFKA_CLUSTER_ID=4L6g3nShT-eMCtK--X86sw

